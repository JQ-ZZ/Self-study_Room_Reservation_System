# 本应用不自动读取 .env；在 PowerShell 或部署工具中设置环境变量。
M3_DATABASE_URL=sqlite:///m3/data/m3.sqlite3
# PostgreSQL 示例：postgresql+psycopg://user:password@localhost:5432/study
M3_M1_BASE_URL=http://127.0.0.1:8000
M3_M1_MODE=demo
# 仅当 A 提供服务鉴权后切换 service；当前 M1 演示版不支持此令牌。
M3_M1_SERVICE_TOKEN=
M3_M2_BASE_URL=
M3_SLA_HOURS=24
M3_POLL_SECONDS=2
M3_SESSION_HOURS=8
# 服务凭据至少 32 字符，分别独立生成；空值意味着禁用对应服务接入。
M3_SERVICE_TOKEN_M1=
M3_SERVICE_TOKEN_M2=
