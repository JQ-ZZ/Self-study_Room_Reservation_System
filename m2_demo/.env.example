# ===== M2 =====
M2_DATABASE_URL=postgresql+psycopg2://app:app@localhost:15432/m2_db
M2_M1_BASE_URL=http://localhost:8081
M2_M1_TIMEOUT_SECONDS=3
M2_JWT_SECRET=change-me-in-real-env
M2_TOKEN_TTL_HOURS=8
M2_APPROVAL_TIMEOUT_SECONDS=90
M2_MAX_APPLICATION_HOURS=12
M2_SYNC_MAX_ATTEMPTS=5
M2_SYNC_INTERVAL_SECONDS=3
M2_WORKER_ENABLED=true
M2_AUTO_CREATE_TABLES=false
M2_DEMO_MODE=true

# ===== 镜像 / 部署 =====
GIT_SHA=dev
GIT_TAG=dev
IMAGE_TAG=dev
